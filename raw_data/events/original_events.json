              ],
              "else": [
                {
                  "type": "LOG",
                  "message": "你手里没有合适的武器！怪物苏醒了并袭击了你！",
                  "style": "alert"
                },
                {
                  "type": "MODIFY_STAT",
                  "stat": "might",
                  "amount": -2
                }
              ]
            }
          ]
        },
        {
          "label": "搜身",
          "effects": [
            {
              "type": "LOG",
              "message": "你忍着恐惧搜寻了一番，发现了一些有用的东西。",
              "style": "info"
            },
            {
              "type": "DRAW_CARD",
